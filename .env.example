# Base API URL of your Cloudflare Worker backend
NEXT_PUBLIC_API_URL=https://rrbgroupdanswerkey.rusikakisku.workers.dev

# Live site URL for canonical links & OpenGraph schemas
NEXT_PUBLIC_SITE_URL=https://rrbgroupdanswerkey.com

# Admin API Secret Token (Authorization: Bearer <TOKEN>)
# Set this securely in your Cloudflare Worker & server-side build environment (DO NOT expose via NEXT_PUBLIC_)
ADMIN_API_KEY=your_secret_admin_token_here

# (Optional) Cloudflare Pages or Vercel Deploy Hook URL to automatically trigger rebuild on post update
CLOUDFLARE_DEPLOY_HOOK_URL=
DEPLOY_HOOK_URL=
